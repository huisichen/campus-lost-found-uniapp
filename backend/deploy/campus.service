[Unit]
Description=Campus lost and found API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=campus
Group=campus
WorkingDirectory=/opt/campus
EnvironmentFile=/opt/campus/backend/.env
ExecStart=/usr/bin/python3 -m backend.server
Restart=on-failure
RestartSec=5
TimeoutStopSec=65
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/campus

[Install]
WantedBy=multi-user.target
