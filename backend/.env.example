# Never put this file's private values into VITE_* or the app bundle.
APP_SECRET=
DATABASE_PATH=backend/data/campus.sqlite3
BIND_HOST=127.0.0.1
PORT=8000
TRUST_PROXY=false
# 本机联调用：1 = 不发信，把验证码打到终端和 backend/data/mail-debug.log。
# 任何公网服务器都必须保持 0，否则验证码会留在日志里。
MAIL_DEBUG=0
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SCHOOL_EMAIL_DOMAIN=whu.edu.cn
# Real verified school-email student number(s), comma separated. No built-in admin.
ADMIN_STUDENT_NOS=
# 试点白名单：只允许这些年级开头的学号申请验证码，如 2025 或 2025,2024。
# 留空 = 不限制（谁都能注册）。学校学号以入学年份开头，2025 级即 2025 开头。
PILOT_STUDENT_PREFIXES=
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 发件人显示名，只影响邮件里显示的名字。
SMTP_FROM_NAME=珞珈失物招领
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
MODEL_DAILY_USER_CALLS=60
MODEL_DAILY_TOKEN_LIMIT=600000
WORKER_COUNT=2
